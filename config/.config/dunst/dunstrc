[global]
frame_width = 1
frame_color = "#788388"
font = Noto Sans 10
format = "<b>%a | %s %p</b>\n%b"
sort = yes
indicate_hidden = yes
alignment = left
transparency = 30
progress_bar_corner_radius = 3
icon_corner_radius = 3
corner_radius = 5
frame_color = "#e2b7f4"
highlight = "#e2b7f4"
separator_color= "#978e98"


[fullscreen]
fullscreen = show


[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 3
background = "#161217"
foreground = "#e9e0e7"
highlight = "#5b396d"

[urgency_normal]
timeout = 6
background = "#161217"
foreground = "#e9e0e7"
highlight = "#5b396d"

[urgency_critical]
timeout = 0
background = "#161217"
foreground = "#e9e0e7"
highlight = "#ffb4ab"
