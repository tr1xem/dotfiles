[global]
frame_width = 1
frame_color = "#788388"
font = Noto Sans 10
format = "<b>%a | %s %p</b>\n%b"
sort = yes
indicate_hidden = yes
alignment = left
transparency = 30
progress_bar_corner_radius = 3
icon_corner_radius = 3
corner_radius = 5
frame_color = "#87d1eb"
highlight = "#87d1eb"
separator_color= "#8a9296"
enable_recursive_icon_lookup = true
icon_theme = Adwaita
icon_path = /usr/share/icons/:~/.local/share/icons/


[fullscreen]
fullscreen = show


[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 3
background = "#0f1416"
foreground = "#dee3e6"
highlight = "#004e60"

[urgency_normal]
timeout = 6
background = "#0f1416"
foreground = "#dee3e6"
highlight = "#004e60"

[urgency_critical]
timeout = 0
background = "#0f1416"
foreground = "#dee3e6"
highlight = "#ffb4ab"
