[global]
frame_width = 1
frame_color = "#788388"
font = Noto Sans 10
format = "<b>%a | %s %p</b>\n%b"
sort = yes
indicate_hidden = yes
alignment = left
transparency = 30
progress_bar_corner_radius = 3
icon_corner_radius = 3
corner_radius = 5
frame_color = "#ffb688"
highlight = "#ffb688"
separator_color= "#9f8d83"
offset = (0, 30)
orgin=top-right

[fullscreen]
fullscreen = show


[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 3
background = "#19120d"
foreground = "#f0dfd7"
highlight = "#6e390f"

[urgency_normal]
timeout = 6
background = "#19120d"
foreground = "#f0dfd7"
highlight = "#6e390f"

[urgency_critical]
timeout = 0
background = "#19120d"
foreground = "#f0dfd7"
highlight = "#ffb4ab"
