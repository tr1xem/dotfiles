[global]
frame_width = 1
frame_color = "#788388"
font = Noto Sans 10
format = "<b>%a | %s %p</b>\n%b"
sort = yes
indicate_hidden = yes
alignment = left
transparency = 30
progress_bar_corner_radius = 3
icon_corner_radius = 3
corner_radius = 5
frame_color = "#d2bcfd"
highlight = "#d2bcfd"
separator_color= "#948f99"
offset = (0, 30)
orgin=top-right

[fullscreen]
fullscreen = show


[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 3
background = "#151218"
foreground = "#e7e0e8"
highlight = "#4f3d74"

[urgency_normal]
timeout = 6
background = "#151218"
foreground = "#e7e0e8"
highlight = "#4f3d74"

[urgency_critical]
timeout = 0
background = "#151218"
foreground = "#e7e0e8"
highlight = "#ffb4ab"
