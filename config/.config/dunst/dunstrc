[global]
frame_width = 1
frame_color = "#788388"
font = Noto Sans 10
format = "<b>%a | %s %p</b>\n%b"
sort = yes
indicate_hidden = yes
alignment = left
transparency = 30
progress_bar_corner_radius = 3
icon_corner_radius = 3
corner_radius = 5
frame_color = "#8fcef3"
highlight = "#8fcef3"
separator_color= "#8b9297"
offset = (0, 30)
orgin=top-right

[fullscreen]
fullscreen = show


[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 3
background = "#0f1417"
foreground = "#dfe3e7"
highlight = "#004c69"

[urgency_normal]
timeout = 6
background = "#0f1417"
foreground = "#dfe3e7"
highlight = "#004c69"

[urgency_critical]
timeout = 0
background = "#0f1417"
foreground = "#dfe3e7"
highlight = "#ffb4ab"
