set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#1b1c15"
set notification-fg             "#c7c8b8"

set completion-bg               "#1b1c15"
set completion-fg               "#c7c8b8"
set completion-group-bg         "#bece7f"
set completion-group-fg         "#2a3400"
set completion-highlight-bg     "#c4caa8"
set completion-highlight-fg     "#2e331b"

set index-bg                    "#13140d"
set index-fg                    "#c7c8b8"
set index-active-bg             "#bece7f"
set index-active-fg             "#2a3400"

set inputbar-bg                 "#1b1c15"
set inputbar-fg                 "#c7c8b8"
set statusbar-bg                "#1b1c15"
set statusbar-fg                "#c7c8b8"

set highlight-fg                rgba(228,227,215,1.0)
set highlight-active-color      rgba(255,208,197,0.5)
set highlight-color             rgba(161,180,171,0.5)

set default-bg                  "#13140d"
set default-fg                  "#c7c8b8"

set render-loading              true
set render-loading-fg           "#13140d"
set render-loading-bg           "#c7c8b8"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#13140d"
set recolor-darkcolor           "#c7c8b8"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
