set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#1e1a20"
set notification-fg             "#cdc3ce"

set completion-bg               "#1e1a20"
set completion-fg               "#cdc3ce"
set completion-group-bg         "#deb9f7"
set completion-group-fg         "#402357"
set completion-highlight-bg     "#d1c1d9"
set completion-highlight-fg     "#372c3f"

set index-bg                    "#161217"
set index-fg                    "#cdc3ce"
set index-active-bg             "#deb9f7"
set index-active-fg             "#402357"

set inputbar-bg                 "#1e1a20"
set inputbar-fg                 "#cdc3ce"
set statusbar-bg                "#1e1a20"
set statusbar-fg                "#cdc3ce"

set highlight-fg                rgba(232,224,232,1.0)
set highlight-active-color      rgba(255,183,187,0.5)
set highlight-color             rgba(244,180,171,0.5)

set default-bg                  "#161217"
set default-fg                  "#cdc3ce"

set render-loading              true
set render-loading-fg           "#161217"
set render-loading-bg           "#cdc3ce"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#161217"
set recolor-darkcolor           "#cdc3ce"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
