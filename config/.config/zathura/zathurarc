set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#161d1d"
set notification-fg             "#bec8c8"

set completion-bg               "#161d1d"
set completion-fg               "#bec8c8"
set completion-group-bg         "#80d4d8"
set completion-group-fg         "#003739"
set completion-highlight-bg     "#b1cccd"
set completion-highlight-fg     "#1b3436"

set index-bg                    "#0e1415"
set index-fg                    "#bec8c8"
set index-active-bg             "#80d4d8"
set index-active-fg             "#003739"

set inputbar-bg                 "#161d1d"
set inputbar-fg                 "#bec8c8"
set statusbar-bg                "#161d1d"
set statusbar-fg                "#bec8c8"

set highlight-fg                rgba(221,228,227,1.0)
set highlight-active-color      rgba(255,199,233,0.5)
set highlight-color             rgba(181,180,171,0.5)

set default-bg                  "#0e1415"
set default-fg                  "#bec8c8"

set render-loading              true
set render-loading-fg           "#0e1415"
set render-loading-bg           "#bec8c8"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#0e1415"
set recolor-darkcolor           "#bec8c8"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
