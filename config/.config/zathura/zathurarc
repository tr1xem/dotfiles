set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#1f1a1f"
set notification-fg             "#cec3cd"

set completion-bg               "#1f1a1f"
set completion-fg               "#cec3cd"
set completion-group-bg         "#e5b6f2"
set completion-group-fg         "#452153"
set completion-highlight-bg     "#d5c0d7"
set completion-highlight-fg     "#392c3d"

set index-bg                    "#161217"
set index-fg                    "#cec3cd"
set index-active-bg             "#e5b6f2"
set index-active-fg             "#452153"

set inputbar-bg                 "#1f1a1f"
set inputbar-fg                 "#cec3cd"
set statusbar-bg                "#1f1a1f"
set statusbar-fg                "#cec3cd"

set highlight-fg                rgba(233,224,231,1.0)
set highlight-active-color      rgba(255,183,180,0.5)
set highlight-color             rgba(245,180,171,0.5)

set default-bg                  "#161217"
set default-fg                  "#cec3cd"

set render-loading              true
set render-loading-fg           "#161217"
set render-loading-bg           "#cec3cd"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#161217"
set recolor-darkcolor           "#cec3cd"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
