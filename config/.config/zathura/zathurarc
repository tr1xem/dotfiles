set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#171c1e"
set notification-fg             "#bfc8cb"

set completion-bg               "#171c1e"
set completion-fg               "#bfc8cb"
set completion-group-bg         "#85d2e7"
set completion-group-fg         "#003641"
set completion-highlight-bg     "#b2cbd3"
set completion-highlight-fg     "#1d343a"

set index-bg                    "#0f1416"
set index-fg                    "#bfc8cb"
set index-active-bg             "#85d2e7"
set index-active-fg             "#003641"

set inputbar-bg                 "#171c1e"
set inputbar-fg                 "#bfc8cb"
set statusbar-bg                "#171c1e"
set statusbar-fg                "#bfc8cb"

set highlight-fg                rgba(222,227,229,1.0)
set highlight-active-color      rgba(255,196,235,0.5)
set highlight-color             rgba(191,180,171,0.5)

set default-bg                  "#0f1416"
set default-fg                  "#bfc8cb"

set render-loading              true
set render-loading-fg           "#0f1416"
set render-loading-bg           "#bfc8cb"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#0f1416"
set recolor-darkcolor           "#bfc8cb"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
