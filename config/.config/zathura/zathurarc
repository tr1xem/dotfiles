set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#181d17"
set notification-fg             "#c2c9bd"

set completion-bg               "#181d17"
set completion-fg               "#c2c9bd"
set completion-group-bg         "#a0d49b"
set completion-group-fg         "#083910"
set completion-highlight-bg     "#b9ccb4"
set completion-highlight-fg     "#253423"

set index-bg                    "#10140f"
set index-fg                    "#c2c9bd"
set index-active-bg             "#a0d49b"
set index-active-fg             "#083910"

set inputbar-bg                 "#181d17"
set inputbar-fg                 "#c2c9bd"
set statusbar-bg                "#181d17"
set statusbar-fg                "#c2c9bd"

set highlight-fg                rgba(224,228,219,1.0)
set highlight-active-color      rgba(255,206,212,0.5)
set highlight-color             rgba(161,180,171,0.5)

set default-bg                  "#10140f"
set default-fg                  "#c2c9bd"

set render-loading              true
set render-loading-fg           "#10140f"
set render-loading-bg           "#c2c9bd"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#10140f"
set recolor-darkcolor           "#c2c9bd"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
