set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#191c20"
set notification-fg             "#c3c6cf"

set completion-bg               "#191c20"
set completion-fg               "#c3c6cf"
set completion-group-bg         "#a4c9fe"
set completion-group-fg         "#00315d"
set completion-highlight-bg     "#bcc7db"
set completion-highlight-fg     "#263141"

set index-bg                    "#111318"
set index-fg                    "#c3c6cf"
set index-active-bg             "#a4c9fe"
set index-active-fg             "#00315d"

set inputbar-bg                 "#191c20"
set inputbar-fg                 "#c3c6cf"
set statusbar-bg                "#191c20"
set statusbar-fg                "#c3c6cf"

set highlight-fg                rgba(225,226,233,1.0)
set highlight-active-color      rgba(255,189,227,0.5)
set highlight-color             rgba(217,180,171,0.5)

set default-bg                  "#111318"
set default-fg                  "#c3c6cf"

set render-loading              true
set render-loading-fg           "#111318"
set render-loading-bg           "#c3c6cf"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#111318"
set recolor-darkcolor           "#c3c6cf"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
