set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#1d1b20"
set notification-fg             "#cbc4cf"

set completion-bg               "#1d1b20"
set completion-fg               "#cbc4cf"
set completion-group-bg         "#d2bcfd"
set completion-group-fg         "#38265c"
set completion-highlight-bg     "#cdc2db"
set completion-highlight-fg     "#342d40"

set index-bg                    "#151218"
set index-fg                    "#cbc4cf"
set index-active-bg             "#d2bcfd"
set index-active-fg             "#38265c"

set inputbar-bg                 "#1d1b20"
set inputbar-fg                 "#cbc4cf"
set statusbar-bg                "#1d1b20"
set statusbar-fg                "#cbc4cf"

set highlight-fg                rgba(231,224,232,1.0)
set highlight-active-color      rgba(255,183,197,0.5)
set highlight-color             rgba(240,180,171,0.5)

set default-bg                  "#151218"
set default-fg                  "#cbc4cf"

set render-loading              true
set render-loading-fg           "#151218"
set render-loading-bg           "#cbc4cf"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#151218"
set recolor-darkcolor           "#cbc4cf"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
