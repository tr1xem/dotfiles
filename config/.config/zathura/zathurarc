set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#171c1f"
set notification-fg             "#c0c7cd"

set completion-bg               "#171c1f"
set completion-fg               "#c0c7cd"
set completion-group-bg         "#8ecff2"
set completion-group-fg         "#003548"
set completion-highlight-bg     "#b5c9d7"
set completion-highlight-fg     "#1f333d"

set index-bg                    "#0f1417"
set index-fg                    "#c0c7cd"
set index-active-bg             "#8ecff2"
set index-active-fg             "#003548"

set inputbar-bg                 "#171c1f"
set inputbar-fg                 "#c0c7cd"
set statusbar-bg                "#171c1f"
set statusbar-fg                "#c0c7cd"

set highlight-fg                rgba(223,227,231,1.0)
set highlight-active-color      rgba(255,194,234,0.5)
set highlight-color             rgba(201,180,171,0.5)

set default-bg                  "#0f1417"
set default-fg                  "#c0c7cd"

set render-loading              true
set render-loading-fg           "#0f1417"
set render-loading-bg           "#c0c7cd"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#0f1417"
set recolor-darkcolor           "#c0c7cd"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
