set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#1e1a1f"
set notification-fg             "#cec3ce"

set completion-bg               "#1e1a1f"
set completion-fg               "#cec3ce"
set completion-group-bg         "#e2b7f4"
set completion-group-fg         "#432254"
set completion-highlight-bg     "#d3c0d8"
set completion-highlight-fg     "#382c3e"

set index-bg                    "#161217"
set index-fg                    "#cec3ce"
set index-active-bg             "#e2b7f4"
set index-active-fg             "#432254"

set inputbar-bg                 "#1e1a1f"
set inputbar-fg                 "#cec3ce"
set statusbar-bg                "#1e1a1f"
set statusbar-fg                "#cec3ce"

set highlight-fg                rgba(233,224,231,1.0)
set highlight-active-color      rgba(255,183,183,0.5)
set highlight-color             rgba(245,180,171,0.5)

set default-bg                  "#161217"
set default-fg                  "#cec3ce"

set render-loading              true
set render-loading-fg           "#161217"
set render-loading-bg           "#cec3ce"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#161217"
set recolor-darkcolor           "#cec3ce"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2

