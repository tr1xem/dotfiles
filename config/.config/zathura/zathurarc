set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#171d1e"
set notification-fg             "#bfc8ca"

set completion-bg               "#171d1e"
set completion-fg               "#bfc8ca"
set completion-group-bg         "#82d3e2"
set completion-group-fg         "#00363e"
set completion-highlight-bg     "#b1cbd1"
set completion-highlight-fg     "#1c3439"

set index-bg                    "#0e1416"
set index-fg                    "#bfc8ca"
set index-active-bg             "#82d3e2"
set index-active-fg             "#00363e"

set inputbar-bg                 "#171d1e"
set inputbar-fg                 "#bfc8ca"
set statusbar-bg                "#171d1e"
set statusbar-fg                "#bfc8ca"

set highlight-fg                rgba(222,227,229,1.0)
set highlight-active-color      rgba(255,197,235,0.5)
set highlight-color             rgba(188,180,171,0.5)

set default-bg                  "#0e1416"
set default-fg                  "#bfc8ca"

set render-loading              true
set render-loading-fg           "#0e1416"
set render-loading-bg           "#bfc8ca"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#0e1416"
set recolor-darkcolor           "#bfc8ca"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
