set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#171d1e"
set notification-fg             "#bec8ca"

set completion-bg               "#171d1e"
set completion-fg               "#bec8ca"
set completion-group-bg         "#81d3df"
set completion-group-fg         "#00363c"
set completion-highlight-bg     "#b1cbcf"
set completion-highlight-fg     "#1c3438"

set index-bg                    "#0e1415"
set index-fg                    "#bec8ca"
set index-active-bg             "#81d3df"
set index-active-fg             "#00363c"

set inputbar-bg                 "#171d1e"
set inputbar-fg                 "#bec8ca"
set statusbar-bg                "#171d1e"
set statusbar-fg                "#bec8ca"

set highlight-fg                rgba(222,228,228,1.0)
set highlight-active-color      rgba(255,198,234,0.5)
set highlight-color             rgba(185,180,171,0.5)

set default-bg                  "#0e1415"
set default-fg                  "#bec8ca"

set render-loading              true
set render-loading-fg           "#0e1415"
set render-loading-bg           "#bec8ca"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#0e1415"
set recolor-darkcolor           "#bec8ca"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
