set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"
set notification-warning-bg     "#ffb86c"
set notification-warning-fg     "#44475a"
set notification-bg             "#171c1f"
set notification-fg             "#c0c8cc"

set completion-bg               "#171c1f"
set completion-fg               "#c0c8cc"
set completion-group-bg         "#89d0ed"
set completion-group-fg         "#003544"
set completion-highlight-bg     "#b3cad5"
set completion-highlight-fg     "#1e333c"

set index-bg                    "#0f1417"
set index-fg                    "#c0c8cc"
set index-active-bg             "#89d0ed"
set index-active-fg             "#003544"

set inputbar-bg                 "#171c1f"
set inputbar-fg                 "#c0c8cc"
set statusbar-bg                "#171c1f"
set statusbar-fg                "#c0c8cc"

set highlight-fg                rgba(222,227,230,1.0)
set highlight-active-color      rgba(255,195,235,0.5)
set highlight-color             rgba(196,180,171,0.5)

set default-bg                  "#0f1417"
set default-fg                  "#c0c8cc"

set render-loading              true
set render-loading-fg           "#0f1417"
set render-loading-bg           "#c0c8cc"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#0f1417"
set recolor-darkcolor           "#c0c8cc"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
