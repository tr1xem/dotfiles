#!/usr/bin/env bash

# User configuration
CALLER_USER="${SUDO_USER:-$USER}"

machine_exists() {
	sudo machinectl list-images | grep subvolume | cut -f 1 -d ' ' | grep -Fxq "${1#*@}"
}

machine_active() {
	sudo machinectl list | grep container | cut -f 1 -d ' ' | grep -Fxq "${1#*@}"
}

list_machines() {
	sudo machinectl list-images | grep subvolume | cut -f 1 -d ' ' | sort
}

have_label() {
	cat /usr/local/etc/nspawn/labels | grep -Fq "${1#*@}"
}

print_label() {
	m="${1#*@}"
	have_label "$1" && ( cat /usr/local/etc/nspawn/labels | grep -F "$m" | cut -f 2 -d ' ' ) || echo "$m"
}

have_terminal() {
	m="${1#*@}"
	( sudo pacman -Qs --sysroot /var/lib/machines/"$m" gaspar-device-gpu >/dev/null && sudo test -f /var/lib/machines/"$m"/usr/bin/ghostty ) || sudo test -f /var/lib/machines/"$m"/usr/bin/ghostty
}

wait_machine() {
	machine="${1#*@}"
	c=0
	while :;
	do
		c=$(( c + 1 ))

		if machine_active "$machine"
		then
			if ! sudo machinectl shell "$machine" /usr/bin/echo 2>&1 >/dev/null
			then
				sleep 1;
				continue
			fi
			return 0
		elif [[ "$c" -ge 5 ]]
		then
			return 1
		fi
	done
}

device_mount() {
	m="${1#*@}"
	d="$2"
	o=${@:3}

	if ! machine_active "$m"
	then
		echo "Machine $m isn't active"
		exit -1
	fi

	if [ ! -b "$2" ] && [ ! -c "$2" ]
	then
		echo "No such device $d"
		exit -1
	fi

	sudo machinectl bind --mkdir "$m" "$d" $o
	systemctl set-property --runtime systemd-nspawn@"$m".service DeviceAllow="$d"
}

upgrade() {
	m="${1#*@}"

	active=false
	machine_active "$m" && active=true

	if [ false = "$active" ]
	then
		sudo machinectl start "$m" && echo nspawn "Booting $m"
	fi

	if wait_machine "$m"
	then
		mirrorlist_mounted=false
		sudo machinectl shell "root@$m" /usr/bin/mount | grep -Fq /etc/pacman.d/mirrorlist && mirrorlist_mounted=true

		sudo machinectl shell "root@$m" /usr/bin/pacman -Syyw
		if [ true = "$mirrorlist_mounted" ]
		then
			sudo machinectl shell "root@$m" /usr/bin/umount /etc/pacman.d/mirrorlist
		fi
		sudo machinectl shell "root@$m" /usr/bin/pacman -Suu
		if [ true = "$mirrorlist_mounted" ]
		then
			sudo machinectl bind --mkdir --read-only "$m" /etc/pacman.d/mirrorlist
		fi
		sudo machinectl shell "root@$m" /usr/bin/pacman -Scc

		if [ -d "/usr/local/etc/nspawn/upgrade/$m" ] ; then
			for f in $(find "/usr/local/etc/nspawn/upgrade/$m" -type f -name "*.sh" | sort -n -t / -k 8n)
			do
				fname=$(basename "$f")
				if echo "$fname" | grep -Fq @
				then
					uname=${fname#*@}
					uname=${uname%%.*}
					host="$uname@$m"
				else
					uname=''
					host="$m"
				fi

				sudo machinectl shell "$host" "/tmp/upgrade/$fname"
			done
		fi
	else
		notify "Failed to upgrade the machine $m"
	fi

	if [ false = "$active" ]
	then
		sudo machinectl poweroff "$m" &&  notify "Powereing off $m"
	else
		sudo machinectl reboot "$m" &&  notify "Rebooting $m"
	fi
}

list_terminals() {
	terminals=""
	if [ ! -f /usr/local/etc/nspawn/terminals ]; then
		return 1
	fi
	while read s
	do
		have_terminal "$s" && terminals="$terminals$s\n"
	done < <(cat /usr/local/etc/nspawn/terminals | sort -t @ -k 2n)
	echo -en "$terminals"
}

# if [[ $EUID -ne 0 ]]
# then
# 	if ! systemd-detect-virt --container >/dev/null 2>&1
# 	then
# 		exec sudo -- "$0" "$@"
# 	fi
# fi

notify() {
	local uid=$(id -u "$CALLER_USER")
	local msg="$@"
	sudo -u "$CALLER_USER" DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
	dunstify "  nspawn" "$msg"
}

show_help() {
	cat << 'EOF'
nspawn - systemd container management script

USAGE:
  nspawn [COMMAND] [OPTIONS]

COMMANDS:
  menu              Open interactive dmenu with available options
  toggle            Toggle machine on/off via dmenu selection
  shell             Open a shell in a selected machine
  terminal          Open a terminal in a selected machine
  upgrade <machine> Upgrade packages in a specified machine
  upgrade_all       Upgrade packages in all machines
  help, -h, --help  Show this help message
  (empty)           Start default terminal (ghostty or ghostty)

UTILITY FUNCTIONS:
  machine_exists <machine>       Check if a machine exists
  machine_active <machine>       Check if a machine is running
  list_machines                  List all available machines
  device_mount <machine> <dev>   Mount a device into a machine
  print_label <machine>          Print machine label
  have_terminal <machine>        Check if machine has terminal support

EXAMPLES:
  nspawn menu                    # Interactive menu
  nspawn toggle                  # Toggle machine state
  nspawn shell                   # Open shell in machine
  nspawn terminal                # Open terminal in machine
  nspawn upgrade arch-main       # Upgrade 'arch-main' machine
  nspawn upgrade_all             # Upgrade all machines

CONFIGURATION FILES:
  /usr/local/etc/nspawn/labels       Machine labels (optional)
  /usr/local/etc/nspawn/terminals    Machines with terminal support
  /usr/local/etc/nspawn/upgrade/<m>  Upgrade scripts for machine <m>

ENVIRONMENT:
  DISPLAY            X11 display (default: :0)
  XAUTHORITY         X11 authority file (default: /tmp/nspawn/xauth)
  SUDO_USER          Used to detect caller user

For more information, see: systemd-nspawn(1), machinectl(1)
EOF
}

upgrade2() {
	DB_DIR=/var/cache/nspawn/pacman/db
	mkdir -p "$DB_DIR"
	pacman -Sy --dbpath "$DB_DIR"
	pkgs=""
	for m in $(list_machines); do
		MACHINE_DIR=/var/lib/machines/"$m"
		mount --mkdir --bind "$DB_DIR" "$MACHINE_DIR$DB_DIR"
		mount | rg pacman
		pacman -Qu --sysroot "$MACHINE_DIR" --dbpath "$DB_DIR"
		pkgs=$pkgs$(pacman -Qu --sysroot "$MACHINE_DIR" --dbpath "$DB_DIR")
		echo "$MACHINE_DIR$DB_DIR"
		ls "$MACHINE_DIR$DB_DIR/sync"
		umount "$MACHINE_DIR$DB_DIR"
		figlet "upgrading $m"
		break
	done
	echo XX
	echo "$pkgs"
}

upgrade_all() {
	for m in $(list_machines); do
		figlet "upgrading $m"
		upgrade "$m"
	done
}

if [[ "$1" == menu ]]
then
	picks="terminal\ntoggle\nshell"
	pick=$(echo -e "$picks" | vicinae dmenu -p "nspawn:")
	[ -z "$pick" ] && exit
	echo -e "$picks" | grep -Fxq "$pick" || exit
	$0 "$pick"
elif [[ "$1" == toggle ]]
then
	list=""
	declare -A machine_map

	while read m
	do
		s=''
		machine_active "$m" && s="currently on" || s="currently off"
		l=$(print_label "$m")
		display="$l ($s)"
		list="$list$display\n"
		machine_map["$display"]="$m"
	done < <(list_machines)

	pick=$(echo -en "$list" | vicinae dmenu -p "toggle:")
	
	[ -z "$pick" ] && exit

	m="${machine_map[$pick]}"
	machine_exists "$m" || exit

	if machine_active "$m"
	then
		sudo machinectl poweroff "$m" &&  notify "Powereing off $m"
	else
		sudo machinectl start "$m" && notify "Booting $m"
	fi
elif [[ "$1" == shell ]]
then
	if [ ! -f /usr/local/etc/nspawn/terminals ]; then
		echo "Error: /usr/local/etc/nspawn/terminals not found"
		exit 1
	fi

	terminals=$(cat /usr/local/etc/nspawn/terminals | sort -t @ -k 2n)

	if [ -z "$terminals" ]; then
		echo "Error: No terminals configured"
		exit 1
	fi

	pick=$(echo "$terminals" | vicinae dmenu -p "shell:")

	if [ -z "$pick" ]; then
		exit 0
	fi

	machine=${pick#*@}

	machine_exists "$machine" || exit 1

	if ! machine_active "$machine"; then
		sudo machinectl start "$machine" && notify "Booting $machine"
	fi

	if wait_machine "$machine"; then
		sudo -u "$CALLER_USER" ghostty -e sh -c "sudo machinectl shell $pick; read"
	else
		notify "Failed to run shell inside $machine"
	fi
elif [[ "$1" == terminal ]]
then
	terminals=$(list_terminals)

	if [ -z "$terminals" ]; then
		echo "Error: No terminals with GPU support found or /usr/local/etc/nspawn/terminals not configured"
		exit 1
	fi

	pick=$(echo -e "$terminals" | vicinae dmenu -p "terminal:")

	if [ -z "$pick" ]; then
		exit 0
	fi

	machine=${pick#*@}

	machine_exists "$machine" || exit 1

	if ! machine_active "$machine"; then
		sudo machinectl start "$machine" && notify "Booting $machine"
	fi

	if wait_machine "$machine"; then
		export DISPLAY=:0
		export XAUTHORITY=/tmp/nspawn/xauth
		sudo machinectl shell "$pick" $0 2>/dev/null
	else
		notify "Failed to run terminal on $machine"
	fi
elif [[ "$1" == "help" ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]
then
	show_help
elif [[ "$1" == '' ]]
then
	export DISPLAY=:0
	export XAUTHORITY=/tmp/nspawn/xauth

	pacman -Qs gaspar-device-gpu >/dev/null && test -f /usr/bin/ghostty && ghostty || ghostty
else
	$1 ${@:2}
fi
