@import "~/.config/rofi/colors.rasi"

/*****----- Configuration -----*****/
configuration {
    font:           "JetBrainsMono Nerd Font 12";
    show-icons:     true;
}

/*****----- Global Properties -----*****/
* {

    background-color: transparent;
    text-color:       @primary-fixed-dim;
}

/*****----- Main Window -----*****/
window {
    // transparency:     true;
    background-color: @surface;
    fullscreen:       true;
    padding:          2%;
}

/*****----- Main Box -----*****/
mainbox {
    children:         [ inputbar, listview ];
    spacing:          3%;
    background-color: transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    spacing:          15px;
    padding:          12px 16px;
    border:           2px;
    border-radius:    10px;
    border-color:     @primary;
    background-color: @on-secondary;
    margin:           0% 20%;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @primary-fixed-dim;
    background-color: transparent;
}

entry {
    background-color: transparent;
    text-color:       @primary;
}

/*****----- List of items -----*****/
listview {
    layout:           vertical;
    columns:          7;
    rows:             2;
    spacing:          16px;
    fixed-height:     true;
    background-color: transparent;
}

/*****----- Elements -----*****/
element {
    orientation:      vertical;
    padding:          30px 20px;
    border-radius:    12px;
    spacing:          20px;
    background-color: @bg-alt;
    cursor:           pointer;
    width:            100px;
    height:           50px;
}

element-icon {
    size:             33%;
    horizontal-align: 0.5;
    background-color: transparent;
    border-radius: 12px;
}

element-text {
    horizontal-align: 0.5;
    background-color: transparent;
    font-weight:      bold;
    text-color:       inherit;
}

element selected.normal {
    background-color: @inverse-primary;
    text-color:       @primary;
}
